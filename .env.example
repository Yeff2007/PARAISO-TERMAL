# Origen del backend del PMS (servidor del sitio)
# Host del backend indicado en el documento; HTTPS fue verificado. Local PMS: http://localhost:3001
BACKEND_URL=https://system.paraisotermal.com.co

# Debe coincidir con WEB_CHECKOUT_SECRET del backend. Solo servidor; nunca NEXT_PUBLIC_*.
WEB_CHECKOUT_SECRET=

# Dominios exactos confirmados por el PMS para las paymentUrl de checkout (sin esquema, separados por coma).
# Mantener vacío hasta que el administrador del PMS confirme los hosts válidos de cada entorno.
PMS_PAYMENT_ALLOWED_HOSTS=

# Opcional: header de IP que el proxy de confianza sobrescribe (nunca aceptar el del cliente tal cual).
# En producción, configúralo solo si el ingress elimina la cabecera entrante y establece su valor real.
# TRUSTED_CLIENT_IP_HEADER=x-forwarded-for
